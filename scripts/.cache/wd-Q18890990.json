by the artist to Professor Helge Bäckström (b. 1865 - d. 1932) and his wife Rägnhild Bäckström (b. 1871 - d. 1908), Stockholm, Sweden [see note 1]. 1924, with Galerie Commeter, Hamburg [see note 2]. 1926, Paul Cassirer, Berlin [see note 3]. Between about 1927 and 1937, with the Moderne Galerie Thannhauser, Berlin [see note 4]. 1937, acquired by Harald Holst Halvorsen (d. 1960), Oslo, Norway [see note 5]; 1959, sold by Halvorsen to the MFA for $35,000. (Accession Date: May 14, 1959)","language":"en"},"type":"monolingualtext"},"datatype":"monolingualtext"}]},"snaks-order":["P854","P813","P1683"]}]},{"mainsnak":{"snaktype":"value","property":"P127","hash":"67d3d8cd6551b0ac6a7c9e50e49e71d7532ed419","datavalue":{"value":{"entity-type":"item","numeric-id":1491856,"id":"Q1491856"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q18890990$a048223e-480b-b93e-44b8-31e7629af045","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P127","hash":"9e17c84cac3e6512656723d2d8e56866856e32bf","datavalue":{"value":{"entity-type":"item","numeric-id":65351,"id":"Q65351"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","qualifiers":{"P585":[{"snaktype":"value","property":"P585","hash":"be340c12c2dda27c5507fe511bba7a8dc9bede9d","datavalue":{"value":{"time":"+1926-00-00T00:00:00Z","timezone":0,"before":0,"after":0,"precision":9,"calendarmodel":"http://www.wikidata.org/entity/Q1985727"},"type":"time"},"datatype":"time"}]},"qualifiers-order":["P585"],"id":"Q18890990$63b009eb-40dd-f2c6-4c32-4e77dcd4fa84","rank":"normal","references":[{"hash":"afdcbab7e953cce547138fa93ebb5fc409a8f6f3","snaks":{"P854":[{"snaktype":"value","property":"P854","hash":"fe45da283a24e4753e79a77da4245eaff062714a","datavalue":{"value":"https://collections.mfa.org/objects/33634/summer-nights-dream-the-voice","type":"string"},"datatype":"url"}],"P813":[{"snaktype":"value","property":"P813","hash":"2e17efdc9b2681cdde998b5f7f5719bbd3960e41","datavalue":{"va